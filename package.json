{
  "name": "spend-musk-money",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform entertainment simulation built with Taro, React and TypeScript.",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "build:pwa": "pnpm run build:h5 && pnpm run h5:layout-check && pnpm run pwa:check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .js,.cjs,.mjs,.ts,.tsx config scripts src tests vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "h5:layout-check": "node scripts/check-h5-layout-build.mjs",
    "pwa:check": "node scripts/check-pwa-build.mjs",
    "asset:check": "node scripts/check-asset-build.mjs",
    "benchmark:weapp:m5": "node scripts/run-weapp-m5-benchmark.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run format:check"
  },
  "dependencies": {
    "@babel/runtime": "7.28.4",
    "@tarojs/components": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.28.6",
    "@babel/preset-react": "7.28.5",
    "@tarojs/cli": "4.2.1",
    "@tarojs/vite-runner": "4.2.1",
    "@types/node": "20.19.43",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@vitejs/plugin-react": "4.7.0",
    "babel-preset-taro": "4.2.1",
    "eslint": "8.57.1",
    "eslint-config-taro": "4.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "miniprogram-automator": "0.12.1",
    "prettier": "3.9.6",
    "react-refresh": "0.14.2",
    "rollup": "3.29.5",
    "sass": "1.102.0",
    "typescript": "5.4.5",
    "vite": "4.5.14",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.4"
  }
}
